<!DOCTYPE html>
<html lang="{{ config.language }}">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light" />
        <meta name="theme-color" content="#ffffff" />
        <meta name="description" content="{{ description }}" />
        {% if url %}<link rel="canonical" href="{{ config.base_url }}{{ url }}" />{% endif %}

        <title>{% if title %}{{ title }} - {% endif %}{{ config.labels.project_title }}</title>

        <link rel="icon" type="image/svg+xml" href="./static/favicon.svg" />
        <link rel="stylesheet" href="./app.css?{{ timestamp }}" />
        <link rel="preload" href="./graph.json" as="fetch" crossorigin />
        <script type="module" src="./app.js?{{ timestamp }}"></script>
        <script type="application/json" id="graph-config">{{ front_config | json_encode | raw }}</script>
    </head>
    <body>
        <header class="site-header">
            <a href="index.html" class="site-title">{{ config.labels.project_title }}</a>

            <label class="toggle">
                <input type="checkbox" name="show-negative" checked />
                {{ config.labels.show_negative }}
            </label>

            <search>
                <input
                    type="search"
                    name="search"
                    placeholder="{{ config.labels.search }}"
                    aria-label="{{ config.labels.search }}"
                    autocomplete="off"
                    role="combobox"
                    aria-expanded="false"
                    aria-controls="search-results"
                    aria-autocomplete="list"
                />
                <ul id="search-results" class="search-results" role="listbox" hidden></ul>
            </search>
        </header>

        <main class="row">
            <article class="column-1">
                {% if title %}
                <h1>{{ title }}</h1>
                {% if not has_card %}
                <p class="missing-card">{{ config.labels.missing_card }}</p>
                {% endif %}
                {% endif %}

                {% if relations %}
                <section class="relations" aria-labelledby="relations-title">
                    <h3 id="relations-title">{{ config.labels.relations }}</h3>
                    <dl>
                        {% for relation in relations %}
                        <dt class="{{ relation.negative ? 'negative' : '' }}">
                            {{ relation.label }}
                            {% if relation.negative %}<span class="badge">{{ config.labels.negative }}</span>{% endif %}
                        </dt>
                        <dd>
                            {% for person in relation.persons %}
                            <a href="{{ person.url }}" class="tag{{ person.has_card ? '' : ' no-card' }}">{{ person.name }}</a>
                            {% if person.note %}<span class="note">({{ person.note }})</span>{% endif %}
                            {% endfor %}
                        </dd>
                        {% endfor %}
                    </dl>
                </section>
                {% endif %}

                <div class="content">{{ content | raw }}</div>

                {% if nearby %}
                <nav class="links" aria-labelledby="nearby-title">
                    <h3 id="nearby-title">{{ config.labels.nearby }}</h3>
                    <ul>
                        {% for person in nearby %}
                        <li><a href="{{ person.url }}">{{ person.name }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
                {% endif %}
            </article>

            <div class="column-2">
                <div id="graph-container" class="graph" data-node="{{ id }}" role="img" aria-label="{{ config.labels.graph }}"></div>
            </div>
        </main>
    </body>
</html>
