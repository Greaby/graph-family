<!DOCTYPE html>
<html lang="{{ config.language }}">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light" />
        <meta name="theme-color" content="#ffffff" />
        <meta name="description" content="{{ description }}" />
        {% if url %}<link rel="canonical" href="{{ config.base_url }}{{ url }}" />{% endif %}

        <title>{% if title %}{{ title }} - {% endif %}{{ config.labels.project_title }}</title>

        <link rel="icon" type="image/svg+xml" href="./static/favicon.svg" />
        <link rel="stylesheet" href="./app.css?{{ timestamp }}" />
        <link rel="preload" href="./graph.json" as="fetch" crossorigin />
        <script type="module" src="./app.js?{{ timestamp }}"></script>
        <script type="application/json" id="graph-config">{{ front_config | json_encode | raw }}</script>
    </head>
    <body>
        {% if config.dev %}
        <svg hidden>
            <symbol id="icon-edit" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16v4Z M13.5 6.5l4 4" /></symbol>
            <symbol id="icon-delete" viewBox="0 0 24 24"><path d="M4 7h16 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3" /></symbol>
            <symbol id="icon-add" viewBox="0 0 24 24"><path d="M12 5v14 M5 12h14" /></symbol>
        </svg>
        {% endif %}
        <header class="site-header">
            <a href="index.html" class="site-title">{{ config.labels.project_title }}</a>

            <div class="toggles">
                <label class="toggle">
                    <input type="checkbox" name="show-negative" checked />
                    {{ config.labels.show_negative }}
                </label>
                <label class="toggle">
                    <input type="checkbox" name="show-groups" checked />
                    {{ config.labels.show_groups }}
                </label>
            </div>

            <search>
                <input
                    type="search"
                    name="search"
                    placeholder="{{ config.labels.search }}"
                    aria-label="{{ config.labels.search }}"
                    autocomplete="off"
                    role="combobox"
                    aria-expanded="false"
                    aria-controls="search-results"
                    aria-autocomplete="list"
                />
                <ul id="search-results" class="search-results" role="listbox" hidden></ul>
            </search>
        </header>

        <main class="row">
            <article class="column-1">
                {% if title %}
                <h1>{{ title }}{% if config.dev %}
                    <span class="dev-actions">
                        {% if group %}
                        <button type="button" data-action="edit-card" data-kind="tags" data-slug="{{ group }}" title="Modifier la description du tag" aria-label="Modifier la description du tag">
                            <svg aria-hidden="true"><use href="#icon-edit" /></svg>
                        </button>
                        <button type="button" data-action="delete-group" data-slug="{{ group }}" data-name="{{ title }}" title="Supprimer le tag" aria-label="Supprimer le tag">
                            <svg aria-hidden="true"><use href="#icon-delete" /></svg>
                        </button>
                        {% else %}
                        <button type="button" data-action="edit-card" data-kind="cards" data-slug="{{ id }}" title="{{ has_card ? 'Modifier la fiche' : 'Créer la fiche' }}" aria-label="{{ has_card ? 'Modifier la fiche' : 'Créer la fiche' }}">
                            <svg aria-hidden="true"><use href="#icon-{{ has_card ? 'edit' : 'add' }}" /></svg>
                        </button>
                        <button type="button" data-action="delete-card" data-slug="{{ id }}" data-name="{{ title }}" title="Supprimer la fiche" aria-label="Supprimer la fiche">
                            <svg aria-hidden="true"><use href="#icon-delete" /></svg>
                        </button>
                        {% endif %}
                    </span>{% endif %}</h1>
                {% if not has_card %}
                <p class="missing-card">{{ config.labels.missing_card }}</p>
                {% endif %}
                {% endif %}

                {% if relations %}
                <section class="relations" aria-labelledby="relations-title">
                    <h3 id="relations-title">{{ relations_title ?: config.labels.relations }}</h3>
                    <dl>
                        {% for relation in relations %}
                        {% if relation.label %}
                        <dt class="{{ relation.negative ? 'negative' : '' }}">
                            {{ relation.label }}
                            {% if relation.negative %}<span class="badge">{{ config.labels.negative }}</span>{% endif %}
                        </dt>
                        {% endif %}
                        <dd>
                            {% for person in relation.persons %}
                            <a href="{{ person.url }}" class="tag{{ person.has_card ? '' : ' no-card' }}">{{ person.name }}</a>
                            {% if person.note %}<span class="note">({{ person.note }})</span>{% endif %}
                            {% if config.dev %}<span class="dev-actions">
                                {% if person.membership %}
                                <button type="button" data-action="edit-membership" data-person="{{ person.membership.person }}" data-group="{{ person.membership.group }}" data-note="{{ person.note }}" title="Modifier" aria-label="Modifier le tag {{ person.membership.group }} de {{ person.membership.person }}">
                                    <svg aria-hidden="true"><use href="#icon-edit" /></svg>
                                </button>
                                <button type="button" data-action="delete-membership" data-person="{{ person.membership.person }}" data-group="{{ person.membership.group }}" title="Retirer" aria-label="Retirer le tag {{ person.membership.group }} de {{ person.membership.person }}">
                                    <svg aria-hidden="true"><use href="#icon-delete" /></svg>
                                </button>
                                {% else %}
                                <button type="button" data-action="edit-relation" data-key="{{ person.relation.key }}" data-tag="{{ person.relation.tag }}" data-to="{{ person.name }}" data-note="{{ person.note }}" title="Modifier la relation" aria-label="Modifier la relation avec {{ person.name }}">
                                    <svg aria-hidden="true"><use href="#icon-edit" /></svg>
                                </button>
                                <button type="button" data-action="delete-relation" data-key="{{ person.relation.key }}" data-label="{{ relation.label }} : {{ person.name }}" title="Supprimer la relation" aria-label="Supprimer la relation avec {{ person.name }}">
                                    <svg aria-hidden="true"><use href="#icon-delete" /></svg>
                                </button>
                                {% endif %}
                            </span>{% endif %}
                            {% endfor %}
                        </dd>
                        {% endfor %}
                    </dl>
                </section>
                {% endif %}

                <div class="content">{{ content | raw }}</div>

                {% if nearby %}
                <nav class="links" aria-labelledby="nearby-title">
                    <h3 id="nearby-title">{{ config.labels.nearby }}</h3>
                    <ul>
                        {% for person in nearby %}
                        <li><a href="{{ person.url }}">{{ person.name }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
                {% endif %}
            </article>

            <div class="column-2">
                <div id="graph-container" class="graph" data-node="{{ id }}" data-group="{{ group }}" role="img" aria-label="{{ config.labels.graph }}"></div>
            </div>
        </main>
    </body>
</html>
